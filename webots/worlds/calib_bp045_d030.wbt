}
Viewpoint {
  orientation -0.577 0.577 0.577 2.094
  position 1.4 1.4 1.4
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  floorSize 2.0 2.0
}

DEF E_PUCK E-puck {
  translation -0.0566 -0.0566 0
  rotation 0 0 1 0
